# Copy to .env.local for local use, and add the same variable in Vercel → Settings → Environment Variables.
# Any long random string. Keeps sign-ins valid across Vercel's servers.
CLASSPULSE_SECRET=replace-with-a-long-random-string

# Optional: where the JSON database is stored. On Vercel it defaults to /tmp/classpulse.
# CLASSPULSE_DATA_DIR=./data
